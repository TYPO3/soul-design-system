# Two calls, one slot: the lookup for a wide figure slide.
flow slide=877,354 columns=340,370 gap=167,16
title "Two calls, one slot"
description "A German call writes the slot of a key. An English call for the same key reads the slot and answers in German. The path of the English call is the one accent."

de `resolve('answer.empty', 'de')` ink at=0,0
en `resolve('answer.empty', 'en')` ink at=0,2
group "cache[]"
  empty `answer.empty` value="Nothing found (de)" at=1,0
  none `answer.none` value="—" at=1,1
  tool `label.tool` value="Tool (de)" at=1,2

de -> empty "writes"
en => empty "answers in de" via=h bend=0.85
