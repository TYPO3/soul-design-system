<?xml version="1.0" encoding="UTF-8" ?>
<!--
    What the renderer needs to be told before it can read this fixture.

    The Markdown parser is a package of its own and is not on by default —
    without this extension the CLI finds the files, recognises no parsing
    strategy for them, and reports that a project has no root document.

    `input-format` is the file extension, not the name the CLI help prints:
    the value goes straight into the filename it looks for, so "Markdown"
    makes it hunt for `index.Markdown`.

    The fixture is reStructuredText because a reference is mostly made of
    nodes Markdown has no spelling for: admonitions, confval, tabs, roles,
    footnotes, glossaries. The Markdown extension stays registered so that
    switching one attribute renders a Markdown project instead.
-->
<guides xmlns="https://www.phpdoc.org/guides"
        input-format="rst"
        links_are_relative="true"
        theme="soul"
        default_code_language="text">
    <project title="Soul — Guides fixture" version="1.0"/>
    <extension class="phpDocumentor\Guides\Markdown\DependencyInjection\MarkdownExtension"/>
    <extension class="phpDocumentor\Guides\Code\DependencyInjection\CodeExtension"/>
    <extension class="TYPO3\Soul\GuidesTheme\DependencyInjection\SoulExtension">
        <product>Acceptance</product>
        <!-- The sections in the bar, which the fixture carries so the suite
             can open one: they are the part of the header a server resolves
             and hands over, and a bar rendered with none of them is a bar
             nothing has asked to write. -->
        <navigation>
            <link href="/index" label="Fixture"/>
            <link href="/nodes" label="Nodes"/>
        </navigation>
    </extension>
</guides>
