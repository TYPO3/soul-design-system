{#
    A code block, fenced in its own language.

    No colour. A fence carries the language as a word, and whatever reads this
    file decides what to do with it. That is the same contract the HTML has,
    where the server writes the colour into the markup. A raw block goes
    through as it is, because raw is what its author asked for.
#}
{%- autoescape false -%}
{%- if node.raw -%}
{{ node.value }}

{% else -%}
{%- if node.caption %}{{ renderNode(node.caption)|md_line }}

{% endif -%}
{{ node.value|md_fence(node.language|default('')) }}

{% endif -%}
{%- endautoescape -%}
