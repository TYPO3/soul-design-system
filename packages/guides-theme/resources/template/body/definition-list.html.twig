{#
    A definition list, and the kind a term can carry — `term : noun`.

    The colon is the classifier's own punctuation and carries the name of its
    part. So a rule and a test can address the kind itself — the core's two
    unrelated names cannot say they belong together.
#}
<dl{% if node.classes %} class="{{ node.classesString }}"{% endif %}>
    {% for definitionListTerm in node.children %}
        {% if definitionListTerm.classifiers is empty %}
            <dt>{{ renderNode(definitionListTerm.term) }}</dt>
        {% else %}
            <dt>
                {{- renderNode(definitionListTerm.term) -}}

                {%- for classifier in definitionListTerm.classifiers %}
                    <span class="sds-classifier__mark">:</span>
                    <span class="sds-classifier">{{ renderNode(classifier) }}</span>
                {%- endfor -%}
            </dt>
        {% endif %}

        {% if definitionListTerm.children %}
            {%- for definition in definitionListTerm.children -%}
            <dd>{{ renderNode(definition) }}</dd>
            {%- endfor ~%}
        {% endif %}
    {% endfor %}
</dl>
