{#
    One side of a split: the blocks that stand as a single column, in the
    rhythm they carry themselves. A column and not a stack — a stack states one
    distance for everything in it, and a heading in here has to keep its own.

    Always a column, even where the half holds one thing: a split lays out
    columns and nothing else, so there is no shape it has to recognise.
#}
<div class="sds-column{{ node.option('class') ? ' ' ~ node.option('class') : '' }}">
    {%- if node.option('heading') -%}
        <h2>{{ node.option('heading') }}</h2>
    {%- endif -%}
    {%- for child in node.children -%}
        {{ renderNode(child) }}
    {%- endfor -%}
</div>
