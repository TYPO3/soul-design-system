{# A wall of marks, and the element draws it. The marks stand between the tags,
   because a list of pictures does not fit in an attribute. #}
<sds-logos
    {%- if node.option('label') %} label="{{ node.option('label') }}"{% endif %}
>
    {%- for child in node.children -%}
        {{ renderNode(child) }}
    {%- endfor -%}
</sds-logos>
