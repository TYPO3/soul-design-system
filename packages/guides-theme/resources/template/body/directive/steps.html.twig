{#
    An instruction read from the top, numbered down one rail.

    The element and not a numbered list of this template's own: the rail, the
    discs and the count are what `sds-steps` draws, and the markup it draws them
    with is not a list a template may take a copy of — see
    `styles/components/steps.css` for why it cannot be `<ol>`.

    No option numbers a stop. The set counts its own, so a step inserted in the
    middle renumbers what follows it.
#}
<sds-steps
    {%- if node.option('class') %} class="{{ node.option('class') }}"{% endif %}>
    {%- for child in node.children -%}
        {{ renderNode(child) }}
    {%- endfor -%}
</sds-steps>
