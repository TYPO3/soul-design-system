{#
    Two of anything, side by side until there is no room for two.

    The class layer and not an element: how far apart two things stand is the
    page's decision rather than a component's, which is the whole reason
    `.sds-split` is a class at all — see `docs/frontend/layout`.

    Every child is a half by the time it arrives — the directive wraps whatever
    was not written as one — so this holds columns and nothing else.
#}
{%- set align = node.option('align') != 'start' ? ' sds-split--' ~ node.option('align') : '' -%}
{%- set leads = node.option('leads') == 'end' ? ' sds-split--leads-end' : '' -%}
{%- set given = node.option('class') ? ' ' ~ node.option('class') : '' -%}
<div class="sds-split{{ align }}{{ leads }}{{ given }}">
    {%- for child in node.children -%}
        {{ renderNode(child) }}
    {%- endfor -%}
</div>
