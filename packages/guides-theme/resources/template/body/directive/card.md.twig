{#- A card is a frame around a heading, a passage and where it goes. The
    frame is the component's; what remains is a linked heading. A sign is
    its meaning in words, as the element says it to a reader who hears it. -#}
{%- autoescape false -%}
{%- set href = node.option('href') ? renderLink(node.option('href')) : linkUrl(node.link) -%}
{%- set heading = node.title.toString|md_escape -%}
{%- set meaning = {yes: 'yes, available', partly: 'in part', no: 'no, missing', unknown: 'not known'}[node.option('sign')] ?? '' -%}
{%- if node.option('label') %}{{ node.option('label')|md_escape }} · {% endif -%}
**{% if href %}[{{ heading }}]({{ href }}){% else %}{{ heading }}{% endif %}**{% if meaning %} ({{ meaning }}){% endif %}

{% for child in node.children -%}
{{ renderNode(child)|md_tidy }}

{% endfor -%}
{%- if node.option('footer') %}{{ node.option('footer')|md_escape }}

{% endif -%}
{%- endautoescape -%}
