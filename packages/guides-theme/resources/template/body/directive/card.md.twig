{#- A card is a frame around a heading, a passage and where it goes. The
    frame is the component's; what remains is a linked heading. -#}
{%- autoescape false -%}
{%- set href = node.option('href') ? renderLink(node.option('href')) : linkUrl(node.link) -%}
{%- set heading = node.title.toString|md_escape -%}
**{% if href %}[{{ heading }}]({{ href }}){% else %}{{ heading }}{% endif %}**

{% for child in node.children -%}
{{ renderNode(child)|md_tidy }}

{% endfor -%}
{%- if node.option('footer') %}{{ node.option('footer')|md_escape }}

{% endif -%}
{%- endautoescape -%}
