{# The existing split, stack and figure compose the page's opening claim.
   Its picture is the one that does not open at full size: it stands beside
   the claim as decoration, and there is nothing in it to read closer.

   The two are level and not top-aligned, because decoration hanging from the
   first line of a claim reads as a column that ran out of words. #}
<div class="sds-sections">
    <div class="sds-split sds-split--center">
        <div class="sds-stack">
            {{- renderNode(node.children|first) -}}
        </div>
        <div class="sds-stack">
            <sds-figure src="{{ asset(node.option('src')) }}" alt="{{ node.option('alt') }}"></sds-figure>
        </div>
    </div>
    {%- for child in node.children|slice(1) -%}
        {{ renderNode(child) }}
    {%- endfor -%}
</div>
