{# The opening claim, and the element draws all of it. **Every option is a
   property.** Each path resolves here, because what a path means is the
   renderer's business.

   The first child stands between the tags. Right under a heading, `Bands`
   puts the heading in it, so the page keeps its one `h1` in every layout.
   What follows it stands under the hero and not in it. #}
{%- set href = node.option('href') ? renderLink(node.option('href')) : '' -%}
{%- set second = node.option('second-href') ? renderLink(node.option('second-href')) : '' -%}
<div class="sds-sections">
    <sds-hero src="{{ asset(node.option('src')) }}" alt="{{ node.option('alt') }}"
        {%- if node.option('plain') %} plain{% endif %}
        {%- if node.option('eyebrow') %} eyebrow="{{ node.option('eyebrow') }}"{% endif %}
        {%- if node.option('action') %} action="{{ node.option('action') }}"{% endif %}
        {%- if href %} href="{{ href }}"{% endif %}
        {%- if node.option('icon') %} icon="{{ node.option('icon') }}"{% endif %}
        {%- if node.option('second') %} second="{{ node.option('second') }}"{% endif %}
        {%- if second %} second-href="{{ second }}"{% endif %}
        {%- if node.option('align') %} valign="{{ node.option('align') }}"{% endif %}
        {%- if node.option('leads') %} leads="{{ node.option('leads') }}"{% endif %}
    >
        {{- renderNode(node.children|first) -}}
    </sds-hero>
    {%- for child in node.children|slice(1) -%}
        {{ renderNode(child) }}
    {%- endfor -%}
</div>
