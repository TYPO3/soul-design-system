{#
    A grid of cards, spelled the way TYPO3 documentation spells it.

    The element and not a `div` wearing its classes: those are the system's own
    names for its own node, and a template that writes one has taken a copy of
    something only the system may change. What the directive worked out is
    handed over as the one property — see `CardGridDirective` for why a count
    becomes a width and why `:gap: 0` is the one gutter a page may ask for.
#}
{%- set given = node.option('class') ? ' class="' ~ node.option('class') ~ '"' : '' -%}
<sds-grid variant="{{ node.option('variant') }}"{{ given|raw }}>
    {%- for child in node.children -%}
        {{ renderNode(child) }}
    {%- endfor -%}
</sds-grid>
