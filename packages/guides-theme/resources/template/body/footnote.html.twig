{#
    `.. [#name] …` — the source under a statement, at the foot of the page.

    The core writes `.footnote` and two parts under it. Renamed here, because
    a class on a page this system draws is a name this system defines: the
    check that holds it is `make coverage`, and a node styled by somebody
    else's name is a node whose look nobody in this repository can find.
#}
<div class="sds-footnote{% if node.classes %} {{ node.classesString }}{% endif %}" id="{{ node.anchor }}">
    <div class="sds-footnote__label">[{{ node.number }}]</div>
    <div class="sds-footnote__content">
        {%- for child in node.children -%}
            {{ renderNode(child) }}
        {%- endfor -%}
    </div>
</div>
