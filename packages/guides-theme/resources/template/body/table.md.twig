{#
    A table, as GitHub Flavoured Markdown writes one.

    A header row and a rule under it, because that is the only table GFM has.
    Where the document declared none, an empty one stands in, which is still a
    table a reader sees the columns of. A cell is a line. What stood between
    two blocks in it becomes the one break a cell permits, and nothing else can
    hold a paragraph.
#}
{%- autoescape false -%}
{%- set rows = node.headers|merge(node.data) -%}
{%- if rows is not empty -%}
{%- if node.hasOption('caption') %}{{ node.option('caption')|md_escape }}

{% endif -%}
{%- if node.headers is empty %}|{% for column in rows|first.columns %} |{% endfor %}

|{% for column in rows|first.columns %} --- |{% endfor %}

{% endif -%}
{% for row in rows %}|{% for column in row.columns %}{% set cell %}{% for child in column.children %}{{ renderNode(child) }}{% endfor %}{% endset %} {{ cell|md_cell }} |{% endfor %}

{% if loop.first and node.headers is not empty %}|{% for column in row.columns %} --- |{% endfor %}

{% endif %}{% endfor %}
{% endif -%}
{%- endautoescape -%}
