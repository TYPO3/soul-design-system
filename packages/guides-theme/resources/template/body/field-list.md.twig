{#- What a page states about itself — the author, the version, the date. A
    table in the HTML, because that is two columns. A list here, because a
    Markdown table with two cells a row is a table in name only. -#}
{%- autoescape false -%}
{%- for item in node.children -%}
{%- set body -%}{% for definition in item.children %}{{ renderNode(definition)|md_tidy }}

{% endfor %}{%- endset -%}
{{ ('**' ~ item.term|md_escape ~ '**' ~ "\n\n" ~ body)|md_indent('- ', '  ') }}
{% endfor %}
{% endautoescape %}