{#
    The rail shows the current section, while the bar moves between sections.
    Navigation\Rail walks the tree because a template cannot derive ancestry.
    sds-rail receives that result as data and owns all of its internal markup.
    `active` includes -1; omitting it would select a page the reader is not on.
    An empty result means the section has no rail, not an empty rail.
#}
{%- set list = rail(node) -%}
{%- if list.items is not empty -%}
<sds-rail
    label="{{ list.label }}"
    items="{{ list.items|json_encode }}"
    active="{{ list.active }}"
></sds-rail>
{%- endif -%}
