    that navigation in the links inside it.
#}
{%- autoescape false -%}
{%- set body -%}
{% for child in node.children %}{{ renderNode(child)|md_tidy }}

{% endfor %}
{%- endset -%}
{{ body|md_tidy }}
{% endautoescape %}