{#
    What fills the layout, and which body it fills it with.

    `:layout: marketing` at the top of a document says it is a landing page;
    anything else is the manual. Decided here because a block cannot choose the
    template it lives in, and `block('body')` is what lets the same content be
    poured into either shape.
#}
{% extends "structure/layout.html.twig" %}

{% set layout = 'default' %}
{%- for headerNode in node.headerNodes -%}
    {%- if headerNode.value == 'marketing' %}{% set layout = 'marketing' %}{% endif -%}
{%- endfor -%}

{#- The rail, rendered here rather than where it is placed, because two things
    below ask whether this page has one: the body, which is a column beside it
    or a column alone, and the bar, whose one button opens it. A page whose
    section is a single page has no rail — see `body/menu/menu.html.twig` — and
    a button standing over nothing is what a reader with no script is left
    pressing. Set outside the blocks so the bar, which is rendered by the
    layout above these, can read it. -#}
{%- set rail -%}
    {%- if layout != 'marketing' -%}
        {%- if parts.mainmenu -%}
            {%- for child in parts.mainmenu %}{{ renderNode(child) }}{% endfor -%}
        {%- else -%}
            {{- renderMenu('mainmenu') -}}
        {%- endif -%}
    {%- endif -%}
{%- endset -%}

{% block head %}
    {%- for headerNode in node.headerNodes -%}
        {{ renderNode(headerNode) }}
    {%- endfor -%}
{% endblock %}

{% block body %}
    {% for child in node.children -%}
        {{ renderNode(child) }}
    {%~ endfor -%}
{% endblock %}

{% block main %}
    {%- if layout == 'marketing' -%}
        <main class="sds-bands" id="main-content">
            {#- The page as its run of bands. `.sds-bands` draws the ground and
                the hairline between two of them, and each band holds its own
                content to the page measure — so they are siblings here and
                never one inside another. `Bands` is where a page that wrote no
                `band` directive becomes the single band it looks like. -#}
            {%- for band in bands(node.children) -%}
                {{ renderNode(band) }}
            {%- endfor -%}
        </main>
    {%- else -%}
        <div class="sds-body">
            {%- if rail|trim %}
            <aside class="sds-body__rail" id="page-rail">{{ rail }}</aside>
            {%- endif %}
            <main class="sds-column" id="main-content">
                {{ renderBreadcrumb() }}
                <article class="sds-prose">{{ block('body') }}</article>
                {#- Inside the column and after the article, because it is the
                    way out of *this page* rather than part of the site: the
                    site's own end is the footer below, on every page alike. -#}
                {%- if soul.pager %}{% include "structure/pager.html.twig" %}{% endif -%}
            </main>
        </div>
    {%- endif -%}
{% endblock %}
