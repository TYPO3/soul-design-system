{#
    The bar. One of them, for every kind of page.

    Its parts are configuration — the mark, the sections, the version, the
    search, the rail it takes in when the page has no column for one — so a
    manual page and a landing page carry the same bar and a reader never has to
    work out which site they are on. What a project sets, and where, is
    `docs/guides-theme/configuration.rst`.

    The sections are written between the tags rather than handed over as data:
    this renderer has resolved its own tree already, and the element does the
    part a server cannot — measure what still fits in the row, and hold the
    rest behind one button.
#}
<sds-header
    home="{{ soul.home ? asset(soul.home) : renderLink('/index') }}"
    {%- if soul.signet %} signet="{{ asset('/' ~ soul.signet) }}"{% endif %}
    {%- if soul.brand %} brand="{{ soul.brand }}"{% endif %}
    product="{{ soul.product|default(env.projectNode.title)|default('Documentation') }}"
    {#- The version is a fact about the documentation the reader is in rather
        than part of the product's name, which is why it is a badge at the
        other end of the bar and not a third line in the mark. -#}
    {%- if env.projectNode.version %} version="{{ env.projectNode.version }}"{% endif %}
    index="{{ root }}_search.json"
    {#- Only where the page has one. The element takes the rail in once the
        layout has no column for it; named a rail that is not there, it would
        be a button standing in the bar with nothing behind it. -#}
    {%- if rail|default('')|trim %} rail="page-rail"{% endif %}
    theme-key="soul-theme"
>{% include "structure/navigation.html.twig" %}</sds-header>
