{
  "name": "typo3/soul-guides-theme",
  "description": "The Soul design system as a theme for phpDocumentor Guides — templates that emit the sds- vocabulary, four directives the renderer does not have, and the drop-in a page links.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "phpdocumentor",
    "guides",
    "theme",
    "documentation",
    "design-system",
    "typo3"
  ],
  "authors": [
    {
      "name": "The TYPO3 Project",
      "homepage": "https://typo3.org/"
    }
  ],
  "support": {
    "issues": "https://github.com/benjaminkott/typo3-soul-design-system/issues",
    "source": "https://github.com/benjaminkott/typo3-soul-design-system"
  },
  "require": {
    "php": "^8.2",
    "phpdocumentor/guides-cli": "^1.9",
    "phpdocumentor/guides-code": "^1.9",
    "phpdocumentor/guides-markdown": "^1.10"
  },
  "require-dev": {
    "typo3/coding-standards": "^0.9"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "TYPO3\\Soul\\GuidesTheme\\": "src/"
    }
  }
}
