<?xml version="1.0" encoding="UTF-8" ?>
<!--
    The documentation, as it is published.

    `docs/` holds two kinds of file. The `.rst` pages are documents: the
    manual, the landing page and the guidelines, rendered into the publish
    root. The `.md` files beside them are not parsed at all — `input-format`
    is `rst` — and that is what makes them useful: a prompt is handed over
    whole, so it is kept as the file it is handed over as, and the page that
    teaches it includes that same file rather than a copy of its text.

    `links_are_relative` because the site is served from a root locally and
    from a repository path on Pages, and absolute links only work at one of
    them.
-->
<guides xmlns="https://www.phpdoc.org/guides"
        input-format="rst"
        links_are_relative="true"
        theme="soul"
        default_code_language="text">
    <project title="Soul Design System" version="1.0"/>
    <extension class="phpDocumentor\Guides\Code\DependencyInjection\CodeExtension"/>
    <!-- What the bar says and shows. Both optional; without them it carries
         the project title above. -->
    <extension class="TYPO3\Soul\GuidesTheme\DependencyInjection\SoulExtension">
        <signet>_images/signet.svg</signet>
        <brand>TYPO3</brand>
        <product>Soul Design System</product>
        <navigation>
            <link href="/design-system" label="Design system"/>
            <link href="/guides-theme/index" label="Guides theme"/>
            <link href="/frontend" label="Frontend"/>
            <link href="/guidelines/index" label="Guidelines"/>
        </navigation>
        <!-- No groups: the columns are the toctree, section by section, and a
             page added below one of them is in the footer the moment it is
             written. What is configured here is only what the tree cannot
             know. -->
        <footer>
            <social href="https://github.com/benjaminkott/typo3-soul-design-system" label="GitHub"/>
            <note>Not an official TYPO3 product.</note>
        </footer>
    </extension>
</guides>
