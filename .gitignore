# generated upload bundle
/ds-bundle/


# staged design-sync converter scripts and their deps
/.ds-sync/

# machine state: screenshots, baselines, diffs, contact sheets
/.design-sync/.cache/

node_modules/

# ephemeral upload manifest
/.design-sync/upload-manifest.json

# generated from the @fontsource packages by scripts/fonts.mjs
/fonts/

# generated from @typo3/icons by scripts/icons.ts — the singles and the map
/assets/icons/

# generated storybook build
/storybook-static/

# generated from @typo3/icons by scripts/icons.mjs, alongside assets/icons/
/src/components/icons.generated.ts
/src/components/icons.svg.generated.ts

# dist/ is committed on purpose: it is the drop-in a consumer copies over a
# plain clone, and `make dist ARGS=--check` proves it still matches its source.
/.dist-check/
/dist/index.js.map
/dist/tsconfig.json

# playwright output
/test-results/
/playwright-report/

# the sync target: a maintainer's, not the repository's
/.design-sync/config.local.json
