# Everything generated that git does not keep — one root, so this file names it
# once and `scripts/lib/cards.ts` says where it is. Nothing is listed inside it
# on purpose: a list here is a second copy of what the scripts write. What is
# ignored below this line is either somebody else's or has to sit where
# something reads it, and each entry says which.
/.out/

# What `make dist ARGS=--check` builds to compare against the committed
# drop-in. Outside `.out/` because it has to be a sibling of `dist/`: the
# comparison is byte for byte, and the generated tsconfig and the sourcemaps
# both name their sources relatively — from anywhere else every path differs.
/packages/frontend/.dist-check/

# Nothing under `packages/frontend/dist/` itself is ignored, and that is
# deliberate: the drop-in is committed so a consumer can take it over a plain
# clone, and the check reads what the build wrote. A file held back here is one
# it reports missing from every fresh clone — and a sourcemap left out is a
# `sourceMappingURL` in the committed drop-in pointing at nothing.

# The design-sync skill's paths rather than this repository's: the staged
# converter and its deps, the cache the skill documents and looks for here —
# screenshots, baselines, diffs, contact sheets, and the anchor a sync compares
# against, which `make baseline` and `make shots` write into — and the manifest
# one upload leaves behind. Outside `.out/` because the skill chose where.
/.ds-sync/
/.design-sync/.cache/
/.design-sync/upload-manifest.json

node_modules/

# The faces are generated from @fontsource, and committed for the same reason
# `dist/` is: they are what the package publishes and what a page links, and a
# mirror can only ship what git has. `make fonts` rebuilds them.

# generated from @typo3/icons by scripts/icons.ts — the single files, which are
# the sprite's source and reach no package. The sprite, the lookup and the
# licence beside them are committed: npm packs a checkout, not a container.
/packages/frontend/assets/icons/svgs/

# generated from @typo3/icons by scripts/icons.ts, alongside assets/icons/
/packages/frontend/src/components/icons.generated.ts
/packages/frontend/src/components/icons.svg.generated.ts

# Never the lock. This is a library rather than an application: what it must
# work against is the constraint in composer.json, and a committed lock would
# pin a consumer's renderer to whatever version happened to resolve here.
/packages/guides-theme/composer.lock

# Composer's own tree. Kept in the working directory rather than in an image
# layer the way node_modules is: it is pure PHP, so it is the same on every
# platform, and a renderer whose dependencies live on the host can be looked
# at without opening a container.
/packages/guides-theme/vendor/

# the fixer's memory of what it has already looked at — machine state, and
# tied to the absolute path it was written under
/packages/guides-theme/.php-cs-fixer.cache

# the drop-in, copied into each project so the renderer can reach it
/packages/guides-theme/acceptance/styles/
/docs/styles/
/docs/_cards/
/packages/guides-theme/acceptance/_cards/

# the sync target: a maintainer's, not the repository's
/.design-sync/config.local.json
