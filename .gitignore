# generated upload bundle
/ds-bundle/


# staged design-sync converter scripts and their deps
/.ds-sync/

# machine state: screenshots, baselines, diffs, contact sheets
/.design-sync/.cache/

node_modules/

# ephemeral upload manifest
/.design-sync/upload-manifest.json

# generated from the @fontsource packages by scripts/fonts.mjs
/fonts/

# generated from @typo3/icons by scripts/icons.ts — the singles and the map
/assets/icons/

# generated storybook build
/storybook-static/

# generated from @typo3/icons by scripts/icons.mjs, alongside assets/icons/
/src/components/icons.generated.ts
/src/components/icons.svg.generated.ts

# dist/ is committed on purpose: it is the drop-in a consumer copies over a
# plain clone, and `make dist ARGS=--check` proves it still matches its source.
# All of it, with nothing held back: the check reads what the build wrote, so
# a file ignored here is one it reports missing from every fresh clone — and
# a sourcemap left out is a `sourceMappingURL` in the committed drop-in that
# points at nothing.
/.dist-check/

# Never the lock. This is a library rather than an application: what it must
# work against is the constraint in composer.json, and a committed lock would
# pin a consumer's renderer to whatever version happened to resolve here.
/guides-theme/composer.lock

# Composer's own tree. Kept in the working directory rather than in an image
# layer the way node_modules is: it is pure PHP, so it is the same on every
# platform, and a renderer whose dependencies live on the host can be looked
# at without opening a container.
/guides-theme/vendor/

# the fixer's memory of what it has already looked at — machine state, and
# tied to the absolute path it was written under
/guides-theme/.php-cs-fixer.cache

# the drop-in, copied into each project so the renderer can reach it
/guides-theme/acceptance/styles/
/docs/styles/
/docs/_cards/
/guides-theme/acceptance/_cards/

# the rendered documentation site — published, never copied, so unlike dist/
# there is nothing to be gained from committing it
/site/

# playwright output
/test-results/
/playwright-report/

# the sync target: a maintainer's, not the repository's
/.design-sync/config.local.json
