{
  "name": "@typo3-support-app/design-system",
  "version": "1.0.0",
  "description": "The TYPO3 Support App design system — tokens, the component class layer, and the specimen cards that document them.",
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "typo3"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "styles.css",
  "style": "styles.css",
  "exports": {
    ".": "./styles.css",
    "./styles.css": "./styles.css",
    "./components.css": "./components.css",
    "./specimen.css": "./_specimen.css",
    "./tokens/*.css": "./tokens/*.css",
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "styles.css",
    "components.css",
    "tokens/",
    "fonts/",
    "assets/"
  ],
  "scripts": {
    "prepare": "npm run fonts && npm run icons",
    "fonts": "node scripts/fonts.mjs",
    "icons": "node scripts/icons.mjs",
    "dev": "npm run gallery && npm run serve",
    "serve": "node scripts/serve.mjs",
    "gallery": "node scripts/gallery.mjs",
    "sync": "npm run build --silent && npm run verify --silent && npm run status --silent && npm run plan --silent",
    "status": "node scripts/status.mjs",
    "plan": "node scripts/plan.mjs",
    "synced": "node scripts/synced.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "fit": "node scripts/fit.mjs",
    "shots": "node scripts/shoot.mjs",
    "baseline": "node scripts/shoot.mjs .design-sync/.cache/baseline",
    "sheets": "node scripts/sheet.mjs",
    "diff": "node scripts/diff.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource/source-code-pro": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@typo3/icons": "^5.0.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0"
  },
  "license": "GPL-2.0-or-later"
}
