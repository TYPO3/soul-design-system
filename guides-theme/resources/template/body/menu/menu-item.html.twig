{#
    One page in the rail, and its children if it has any.

    A page with children is a `<details>`, open when the reader is inside it —
    `isInRootline` is exactly that question. A page without children is an
    anchor and nothing more.

    `is-active` marks the page being read, and it carries `aria-current` for a
    reader who cannot see the mark. `isCurrent` and `isInRootline` are two
    different states and only the first one is the page itself.
#}
{%- if node.children|length -%}
    <details class="sds-rail__group"{% if node.isInRootline %} open{% endif %}>
        <summary>{{ node.value.toString }}</summary>
        <a class="sds-rail__item{% if node.isCurrent %} is-active{% endif %}"
           href="{{ url }}"{% if node.isCurrent %} aria-current="page"{% endif %}>{{ node.value.toString }}</a>
        {%- for child in node.children -%}
            {{ renderNode(child) }}
        {%- endfor -%}
    </details>
{%- else -%}
    <a class="sds-rail__item{% if node.isCurrent %} is-active{% endif %}"
       href="{{ url }}"{% if node.isCurrent %} aria-current="page"{% endif %}>{{ node.value.toString }}</a>
{%- endif -%}
