{#
    A configuration value: the name a reader searches for, what it takes, and
    what happens if they leave it alone.

    The core template labels the default `Type:` — the same word it uses for
    the type, two lines above. That is an upstream defect and this is where it
    stops being one.

    A definition list rather than a card: `document.css` already sets `dt` and
    `dd`, a reference is mostly made of these, and forty of them in a row must
    read as a list and not as forty boxes.
#}
<dl class="sds-confval">
    <dt{% if node.isNoindex == false %} id="{{ node.anchor }}"{% endif %}>
        <code class="sds-mono">{{ node.plainContent }}</code>
        {%- if node.required %} <span class="sds-badge sds-badge--warn">required</span>{% endif -%}
    </dt>
    <dd>
        {%- if node.type or node.default != null %}
            {#- The key is a label and the value is not: upper-cased, "type
                script" reads as the name of a language. -#}
            <p>
                {%- if node.type %}<span class="sds-label">type</span>
                    <span class="sds-mono">{{ renderNode(node.type) }}</span>{% endif -%}
                {%- if node.type and node.default != null %} · {% endif -%}
                {%- if node.default != null %}<span class="sds-label">default</span>
                    <span class="sds-mono">{{ renderNode(node.default) }}</span>{% endif -%}
            </p>
        {%- endif %}
        {%- for key, option in node.additionalOptions %}
            <p><span class="sds-label">{{ key }}</span>
                <span class="sds-mono">{{ renderNode(option) }}</span></p>
        {%- endfor %}
        {{ renderNode(node.value) }}
    </dd>
</dl>
