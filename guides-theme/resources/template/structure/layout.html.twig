{#
    The page a rendered document sits in.

    The core layout is an `<html>`, a `<title>` and two blocks. This is the
    same thing wearing the system: the bar that stays, the rail beside the
    column, the column that holds the measure, and `.sds-prose` around whatever
    the renderer produced — which is what makes `document.css` apply to a `<p>`
    nobody could put a class on.

    Two stylesheets and no third. `soul.css` carries the tokens, the faces and
    the component layer; `document.css` is the layer for elements that arrive
    bare, and it is a separate file exactly so that a page which is not a
    document never gets it. See the head of `src/styles/document.css`.

    `soul.js` is deferred and optional on purpose: the colour of a code block
    is already in the markup the server wrote, and every element this system
    ships is an upgrade of markup that reads without it. A reader with no
    JavaScript loses the mode switch and the fold in the rail, not the page.

    The blocks are filled by `structure/document.html.twig`.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}
    {%- if title!=null and env.projectNode.title!=null %} — {% endif -%}
    {%- if env.projectNode.title -%}{{ env.projectNode.title }}{%- endif -%}</title>
<link rel="stylesheet" href="{{ asset('/styles/soul.css') }}" />
<link rel="stylesheet" href="{{ asset('/styles/document.css') }}" />
<script type="module" src="{{ asset('/styles/soul.js') }}" defer></script>
{%~ block head %}
{%~ endblock %}
</head>
<body class="sds-app">
<div class="sds-shell">
    {#
        The bar stays. It is the frame the page is read inside — the mark, and
        the one control that belongs to the reader rather than to the text.
    #}
    <header class="sds-bar">
        {# The mark, and the one template a project replaces to make this its
           own — see `structure/brand.html.twig`. #}
        {% include "structure/brand.html.twig" %}
        {% include "structure/navigation.html.twig" %}
        <div class="sds-bar__end">
            {#
                A mode switch is the one control a documentation page owes its
                reader. It is an element, so it needs the script — and without
                it the page still renders in whichever mode the reader's system
                asked for, which is the honest fallback.
            #}
            <sds-theme></sds-theme>
        </div>
    </header>

    <div class="sds-body">
        <aside class="sds-body__rail">
            {%~ block menu %}
            {%~ endblock %}
        </aside>

        <main class="sds-column">
            {%~ block breadcrumb %}
            {%~ endblock %}

            <article class="sds-prose">
{%~ block body %}
{%~ endblock %}
            </article>
        </main>
    </div>

    {% include "structure/footer.html.twig" %}
</div>
{#
    The mode, into the frames.

    A specimen is a document of its own, and a document does not inherit the
    mode the page around it was forced into: `data-theme` on this `<html>` says
    nothing about the one inside an iframe. Left alone, a reader who switches
    to dark gets a dark page with light cards in it — which is not a rendering
    of anything the system does.

    Same origin, so this is four lines rather than a message channel. Without
    JavaScript nothing here runs and every frame follows the reader's system
    setting, which is the honest fallback: the page does too.
#}
<script>
(function () {
  var root = document.documentElement;
  function paint() {
    var mode = root.getAttribute('data-theme');
    document.querySelectorAll('.sds-figure__frame iframe').forEach(function (frame) {
      try {
        var inner = frame.contentDocument && frame.contentDocument.documentElement;
        if (!inner) return;
        if (mode) inner.setAttribute('data-theme', mode);
        else inner.removeAttribute('data-theme');
      } catch (e) { /* not same origin — nothing to do and nothing broken */ }
    });
  }
  document.querySelectorAll('.sds-figure__frame iframe').forEach(function (frame) {
    frame.addEventListener('load', paint);
  });
  new MutationObserver(paint).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  paint();
})();
</script>
</body>
</html>
