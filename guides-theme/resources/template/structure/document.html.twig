{#
    What fills the layout, and which body it fills it with.

    `:layout: marketing` at the top of a document says it is a landing page;
    anything else is the manual. Decided here because a block cannot choose the
    template it lives in, and `block('body')` is what lets the same content be
    poured into either shape.
#}
{% extends "structure/layout.html.twig" %}

{% set layout = 'default' %}
{%- for headerNode in node.headerNodes -%}
    {%- if headerNode.value == 'marketing' %}{% set layout = 'marketing' %}{% endif -%}
{%- endfor -%}

{% block head %}
    {%- for headerNode in node.headerNodes -%}
        {{ renderNode(headerNode) }}
    {%- endfor -%}
{% endblock %}

{% block body %}
    {% for child in node.children -%}
        {{ renderNode(child) }}
    {%~ endfor -%}
{% endblock %}

{% block main %}
    {%- if layout == 'marketing' -%}
        <main class="sds-bands">
            {#- One band around whatever the page wrote: `.sds-bands` draws the
                ground and the hairline between two of them, and a band is what
                holds content to the page measure. A page that wants more says
                so with the `band` directive. -#}
            <section class="sds-band">
                <div class="sds-prose">{{ block('body') }}</div>
            </section>
        </main>
    {%- else -%}
        <div class="sds-body">
            <aside class="sds-body__rail" id="page-rail">
                {% if parts.mainmenu %}
                    {% for child in parts.mainmenu %}{{ renderNode(child) }}{% endfor %}
                {% else %}
                    {{ renderMenu('mainmenu') }}
                {% endif %}
            </aside>
            <main class="sds-column">
                {{ renderBreadcrumb() }}
                <article class="sds-prose">{{ block('body') }}</article>
            </main>
        </div>
    {%- endif -%}
{% endblock %}
